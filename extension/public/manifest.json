{
  "manifest_version": 3,
  "name": "Job Application Tool",
  "version": "0.1.0",
  "description": "Control panel for the locally-hosted job application automator.",
  "permissions": [
    "storage",
    "alarms",
    "sidePanel",
    "cookies"
  ],
  "host_permissions": [
    "http://127.0.0.1:7432/*",
    "https://www.linkedin.com/*",
    "https://*.linkedin.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'self';"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "action": {
    "default_title": "Job Application Tool"
  },
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  }
}
