# Copy this file to .env and fill in all values before running docker compose.
# Never commit .env to git.

# Anthropic Claude API key (required)
CLAUDE_API_KEY=

# Gmail credentials for SMS notifications via email-to-SMS gateway
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Google Apps Script Web App deployment URL (from gas/Code.gs deployment)
GOOGLE_APPS_SCRIPT_URL=

# API bearer token for the Chrome Extension to authenticate with the Automator.
# Leave blank on first run — the Automator will generate one automatically.
API_TOKEN=

# Host path for the mounted data volume (holds state.db, PDFs, logs, backups)
DATA_DIR=./data

# Log level: DEBUG | INFO | WARNING | ERROR (default: INFO)
LOG_LEVEL=INFO

# Set to 1 to enable Playwright trace recording (saved to data/traces/)
PLAYWRIGHT_TRACE=0
