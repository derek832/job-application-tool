# Copy this file to .env and fill in all values before running docker compose.
# Never commit .env to git.

# Anthropic Claude API key (required)
CLAUDE_API_KEY=

# Gmail/Workspace account used as the sender for resume PDF export.
# Authentication uses OAuth2 (token stored in data/gmail_token.json).
# No app password needed — run the authorization flow once during setup.
GMAIL_USER=

# Google Apps Script Web App deployment URL (from gas/Code.gs deployment)
GOOGLE_APPS_SCRIPT_URL=

# API bearer token for the Chrome Extension to authenticate with the Automator.
# Leave blank on first run — the Automator will generate one automatically.
API_TOKEN=

# Host path for the mounted data volume (holds state.db, PDFs, logs, backups)
DATA_DIR=./data

# Log level: DEBUG | INFO | WARNING | ERROR (default: INFO)
LOG_LEVEL=INFO

# Set to 1 to enable Playwright trace recording (saved to data/traces/)
PLAYWRIGHT_TRACE=0

# Optional: Override auto-detected LAN IP for ntfy action buttons.
# When unset, the automator resolves the host IP via host.docker.internal DNS.
# Set this if auto-detection doesn't work for your Docker/network setup.
# Accepts an IP address or hostname (e.g., LAN_IP=192.168.1.100)
LAN_IP=
